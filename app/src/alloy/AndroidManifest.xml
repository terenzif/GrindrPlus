<?xml version="1.0" encoding="utf-8"?>
<!-- Alloy: rooted Vector module (sole user-facing Xposed registrant). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Install-only permissions are Morphe's; Alloy scopes Grindr via Vector. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REQUEST_DELETE_PACKAGES"
        tools:node="remove" />

    <application>
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Grindr++ Alloy — Vector module (NexAlloy-style runtime)"
            tools:replace="android:value" />
        <meta-data
            android:name="xposedminversion"
            android:value="103" />
        <meta-data
            android:name="xposedscope"
            android:value="com.grindrapp.android" />
        <service
            android:name="com.gpp.bridge.BridgeService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            tools:node="merge">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="xposed_module"
                tools:replace="android:value" />
        </service>
    </application>
</manifest>
