{
  "enabled": true,
  "provider": "goatcounter",
  "site": "https://grindr-plus.goatcounter.com",
  "public_url": "https://grindr-plus.goatcounter.com",
  "docs": "https://github.com/terenzif/GrindrPlus/blob/master/docs/analytics.md",
